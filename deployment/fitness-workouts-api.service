[Unit]
Description=Fitness.Workouts.Api Service
After=syslog.target network.target

[Service]
User=USER_PLACEHOLDER
EnvironmentFile=-/opt/Fitness.Workouts.Api/Fitness.Workouts.Api.env
ExecStart=/usr/bin/java -jar /opt/Fitness.Workouts.Api/Fitness.Workouts.Api-0.0.1-SNAPSHOT.jar
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SuccessExitStatus=143
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
